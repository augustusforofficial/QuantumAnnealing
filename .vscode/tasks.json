{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "C/C++: gcc (WSL)",
            "command": "/usr/bin/gcc",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "${workspaceFolder}/src/annealing_util.c",
                "-I",
                "${workspaceFolder}/src",
                "-o",
                "${workspaceFolder}/bin/${fileBasenameNoExtension}",
                "-lm"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Compiler: /usr/bin/gcc (WSL Ubuntu)"
        },
        {
            "type": "shell",
            "label": "C/C++: gcc OpenMP (WSL)",
            "command": "/usr/bin/gcc",
            "args": [
                "-fdiagnostics-color=always",
                "-fopenmp",
                "-g",
                "${file}",
                "${workspaceFolder}/src/annealing_util.c",
                "-I",
                "${workspaceFolder}/src",
                "-o",
                "${workspaceFolder}/bin/${fileBasenameNoExtension}",
                "-lm"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Compiler: /usr/bin/gcc (WSL Ubuntu)"
        },
        {
            "type": "shell",
            "label": "C/C++ nvcc (WSL)",
            "command": "/usr/local/cuda/bin/nvcc",
            "args": [
                "-std=c++17",
                "-g",
                "${file}",
                "-o",
                "${workspaceFolder}/bin/${fileBasenameNoExtension}",
                "-lcublas"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "type": "cmake",
            "label": "CMake: クリーンしてリビルド",
            "command": "cleanRebuild",
            "targets": [
                "[N/A - キットの選択]"
            ],
            "group": "build",
            "problemMatcher": [],
            "detail": "CMake テンプレート クリーンしてリビルド タスク"
        }
    ]
}