{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "cppbuild",
			"label": "C/C++: gcc (WSL)",
			"command": "/usr/bin/gcc",
			"args": [
				"-fdiagnostics-color=always",
				"-g",
				"${file}",
				"${workspaceFolder}/src/annealing_util.c",
				"-I",
				"${workspaceFolder}/src",
				"-o",
				"${workspaceFolder}/bin/${fileBasenameNoExtension}",
				"-lm"
			],
			"options": {
				"cwd": "${fileDirname}"
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": {
				"kind" : "build",
				"isDefault": true
			},
			"detail": "Compiler: /usr/bin/gcc (WSL Ubuntu)"
		}
	]
}